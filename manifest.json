{
  "manifest_version": 3,
  "name": "Website A11y Checker",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
      "lib/axe.min.js",
      "content.js"
      ]
    }
  ]
}