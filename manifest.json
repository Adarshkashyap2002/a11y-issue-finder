{
  "manifest_version": 3,
  "name": "Website A11y Checker",
  "version": "1.0.1",
  "description": "Scan webpages for accessibility issues using axe-core.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/axe.min.js",
        "content.js"
      ]
    }
  ]
}
